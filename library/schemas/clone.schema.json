{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whitehats.local/schemas/clone.schema.json",
  "title": "CloneDocument",
  "description": "Versioned clone of a customer estate. Secret values are refused; credentials are vault:// references. schema_version is this document shape (currently 1). library_version is the node library the type refs were taken from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "clone",
    "environment",
    "library_version",
    "version",
    "nodes",
    "edges",
    "groups",
    "access_paths",
    "credential_refs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "clone": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "environment": {"$ref": "#/$defs/environment"},
    "library_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}$"},
    "version": {"$ref": "#/$defs/version"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "access_paths": {"type": "array", "items": {"$ref": "#/$defs/accessPath"}},
    "credential_refs": {"type": "array", "items": {"$ref": "#/$defs/credentialRef"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,80}$"},
    "typeRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@[1-9][0-9]*$",
      "description": "Library type plus schema version, for example service.backend@1."
    },
    "environment": {"enum": ["prod", "staging", "dev", "dr", "shared"]},
    "vaultRef": {
      "type": "string",
      "pattern": "^vault://tenant/[a-z][a-z0-9-]{0,62}(/[a-z0-9][a-z0-9_-]*)+$",
      "description": "vault://tenant/<company>/<path>. No empty segments, no .., and the company is the caller's slug."
    },
    "safeString": {
      "type": "string",
      "maxLength": 2000,
      "description": "Free text. Secret-shaped values are rejected in code, not by a pattern here."
    },
    "when": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "author", "reason"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "author": {"$ref": "#/$defs/safeString"},
        "reason": {"$ref": "#/$defs/safeString"},
        "created_at": {"$ref": "#/$defs/when"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["imported", "discovered", "drawn"]},
        "source": {"$ref": "#/$defs/safeString"}
      }
    },
    "layout": {
      "type": "object",
      "description": "Where the Studio draws the item, in pixels, from the top left corner of the group it sits in (or of the canvas). Only a group has a size.",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "propertyBag": {
      "type": "object",
      "patternProperties": {
        "(?i)(^|_)(password|passwd|passphrase|secret_key|secret|api_key|apikey|token|private_key|access_key|connection_string|credentials)$": {
          "$ref": "#/$defs/vaultRef"
        }
      },
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "safeValue": {
      "oneOf": [
        {"$ref": "#/$defs/safeString"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}},
        {"$ref": "#/$defs/propertyBag"}
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "environment"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"$ref": "#/$defs/typeRef"},
        "name": {"$ref": "#/$defs/safeString", "minLength": 1},
        "environment": {"$ref": "#/$defs/environment"},
        "owner": {"$ref": "#/$defs/safeString"},
        "criticality": {"enum": ["crown-jewel", "high", "medium", "low"]},
        "data_classification": {
          "type": "array",
          "items": {"enum": ["PHI", "PCI", "PII", "financial", "secret", "internal", "public"]}
        },
        "compliance_scope": {
          "type": "array",
          "items": {"enum": ["HIPAA", "PCI DSS", "SOC 2", "GDPR", "ISO 27001", "DPDP"]}
        },
        "location": {"$ref": "#/$defs/id"},
        "access_path": {"$ref": "#/$defs/id"},
        "credential": {"oneOf": [{"$ref": "#/$defs/vaultRef"}, {"$ref": "#/$defs/id"}]},
        "tags": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safeString"}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "last_confirmed_at": {"$ref": "#/$defs/when"},
        "notes": {"$ref": "#/$defs/safeString"},
        "layout": {"$ref": "#/$defs/layout"},
        "properties": {"$ref": "#/$defs/propertyBag"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "type": {
          "enum": [
            "calls",
            "publishes_to",
            "consumes_from",
            "reads",
            "writes",
            "deploys_from",
            "built_by",
            "pushes_image_to",
            "runs_on",
            "runs_as",
            "contained_in",
            "routes_through",
            "authenticates_via",
            "stores_secret_in",
            "emits_telemetry_to",
            "replicates_to",
            "backs_up_to",
            "depends_on",
            "peers_with",
            "syncs_with",
            "generic_relation"
          ]
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "properties": {"$ref": "#/$defs/propertyBag"}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "kind", "environment"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"$ref": "#/$defs/typeRef"},
        "name": {"$ref": "#/$defs/safeString", "minLength": 1},
        "kind": {
          "enum": [
            "organisation",
            "account",
            "subscription",
            "management-group",
            "resource-group",
            "project",
            "region",
            "availability-zone",
            "vpc",
            "subnet",
            "security-group",
            "cluster",
            "namespace",
            "site",
            "data-centre",
            "office",
            "trust-zone",
            "business-unit",
            "third-party"
          ]
        },
        "environment": {"$ref": "#/$defs/environment"},
        "parent": {"$ref": "#/$defs/id"},
        "owner": {"$ref": "#/$defs/safeString"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "notes": {"$ref": "#/$defs/safeString"},
        "layout": {"$ref": "#/$defs/layout"},
        "properties": {"$ref": "#/$defs/propertyBag"}
      }
    },
    "accessPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "environment"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/safeString", "minLength": 1},
        "kind": {
          "enum": [
            "public-api",
            "vpn-client",
            "site-to-site",
            "customer-hosted-runner",
            "bastion",
            "private-link",
            "offline"
          ]
        },
        "client": {
          "enum": [
            "openvpn",
            "wireguard",
            "anyconnect",
            "globalprotect",
            "forticlient",
            "pulse",
            "checkpoint",
            "ikev2",
            "ztna",
            "other"
          ]
        },
        "environment": {"$ref": "#/$defs/environment"},
        "routes": {
          "type": "array",
          "description": "IP networks. Checked with ipaddress in code so IPv6 is allowed and octets are real.",
          "items": {"type": "string", "maxLength": 64}
        },
        "credential": {"oneOf": [{"$ref": "#/$defs/vaultRef"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vault_uri", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "vault_uri": {"$ref": "#/$defs/vaultRef"},
        "purpose": {"$ref": "#/$defs/safeString", "minLength": 1}
      }
    }
  }
}
